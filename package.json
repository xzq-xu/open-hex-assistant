{
  "name": "open-hex-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean-room open-source ARAM Mayhem recommendation prototype without license or device binding.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "overlay:dev": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs",
    "overlay:ocr:dev": "cross-env OCR_ENABLED=1 VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs",
    "overlay:dist": "npm run build && electron electron/main.cjs",
    "calibrate:dev": "cross-env APP_MODE=calibrate VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs",
    "calibrate:dist": "npm run build && cross-env APP_MODE=calibrate electron electron/main.cjs",
    "ocr:models": "node scripts/prepare-paddleocr-models.mjs",
    "ocr:probe": "cross-env OCR_ONCE=1 node electron/ocr-worker.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "^1.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "screenshot-desktop": "^1.15.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "vite": "^7.0.0"
  }
}
